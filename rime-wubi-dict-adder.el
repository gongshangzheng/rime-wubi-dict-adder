;;; Commentary:

;; Add a word (or a batch of words) plus its Wubi code to a Rime user
;; dictionary.  Codes are generated by `dictAdder.py' (pywubi) through
;; `call-process' -- no shell is involved, so words are never re-interpreted by
;; a shell.
;;
;; Words that are already in the dictionary are answered from an in-memory index
;; (invalidated by the dictionary's mtime/size), so repeat calls cost no process
;; at all.  Invalid input (mixed scripts, whitespace, unusable codes) is
;; rejected before anything is written.

;;; Code:

(require 'json)
(require 'seq)
(require 'subr-x)

(defgroup rime-wubi-dict-adder nil
  "Add words to a Rime Wubi dictionary."
  :group 'tools)

(defun rime-wubi-dict-adder--module-directory ()
  "Return the directory holding this file."
  (file-name-directory
   (or load-file-name
       buffer-file-name
       (locate-library "rime-wubi-dict-adder")
       (error "Cannot locate rime-wubi-dict-adder.el"))))

(defcustom rime-wubi-dict-adder-python-command
  (let ((venv (expand-file-name ".venv/bin/python"
                                (rime-wubi-dict-adder--module-directory))))
    (if (file-exists-p venv) venv "python3"))
  "Python interpreter used to run `dictAdder.py'.\nDefaults to the module's virtualenv when it exists, otherwise \"python3\"."
  :type 'string)

(defcustom rime-wubi-dict-adder-script-path
  (expand-file-name "dictAdder.py" (rime-wubi-dict-adder--module-directory))
  "Path to `dictAdder.py'."
  :type 'file)

(defcustom rime-wubi-dict-adder-user-dict
  (cond
   ((string-equal system-type "darwin")
    "~/Library/Rime/wubi86_jidian_user.dict.yaml")
   ((string-equal system-type "gnu/linux")
    (if (file-exists-p "~/.config/ibus/rime/wubi86_jidian_user.dict.yaml")
        "~/.config/ibus/rime/wubi86_jidian_user.dict.yaml"
      "~/.local/share/fcitx5/rime/wubi86_jidian_user.dict.yaml"))
   (t "~/.config/ibus/rime/wubi86_jidian_user.dict.yaml"))
  "Rime user dictionary that words are appended to."
  :type 'file)

(defcustom rime-wubi-dict-adder-deploy-command nil
  "Command run after a successful write to redeploy Rime, or nil to skip.\nExample on macOS with Squirrel: a list whose first element is\n\"/Library/Input Methods/Squirrel.app/Contents/MacOS/rime_deployer\"."
  :type '(choice (const :tag "Do not redeploy" nil) (repeat string)))

(defconst rime-wubi-dict-adder--code-regexp "\\`[a-z]\\{1,4\\}\\'"
  "Regexp matching a valid Wubi code.")

(defconst rime-wubi-dict-adder--word-regexp
  "\\`[㐀-䶿一-鿿\U00020000-\U0003ffff]+\\'"
  "Regexp matching a word made only of CJK ideographs.")

(defvar rime-wubi-dict-adder--index nil
  "Cached dictionary index: (STAMP . HASH-TABLE) or nil.\nSTAMP is (MTIME . SIZE) of the dictionary when the index was built.")

;;;; Dictionary access

(defun rime-wubi-dict-adder--dict-file ()
  "Return the expanded path of the user dictionary."
  (expand-file-name rime-wubi-dict-adder-user-dict))

(defun rime-wubi-dict-adder--dict-stamp (file)
  "Return the (MTIME . SIZE) stamp of FILE, or nil when it is missing."
  (let ((attrs (file-attributes file)))
    (when attrs
      (cons (float-time (file-attribute-modification-time attrs))
            (file-attribute-size attrs)))))

(defun rime-wubi-dict-adder--invalidate-index ()
  "Forget the cached dictionary index."
  (setq rime-wubi-dict-adder--index nil))

(defun rime-wubi-dict-adder--index ()
  "Return the set of words currently in the dictionary as a hash table."
  (let* ((file (rime-wubi-dict-adder--dict-file))
         (stamp (rime-wubi-dict-adder--dict-stamp file)))
    (if (and rime-wubi-dict-adder--index
             (equal stamp (car rime-wubi-dict-adder--index)))
        (cdr rime-wubi-dict-adder--index)
      (let ((table (make-hash-table :test #'equal)))
        (when stamp
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            (while (not (eobp))
              (let ((line (buffer-substring-no-properties
                           (line-beginning-position) (line-end-position))))
                (when (and (not (string-prefix-p "#" line))
                           (string-match "\\`\\([^\t]+\\)\t" line))
                  (puthash (match-string 1 line) t table)))
              (forward-line 1))))
        (setq rime-wubi-dict-adder--index (cons stamp table))
        table))))

(defun rime-wubi-dict-adder--known-p (word)
  "Return non-nil when WORD is already in the dictionary."
  (gethash word (rime-wubi-dict-adder--index)))

;;;; Running dictAdder.py

(defun rime-wubi-dict-adder--call (args)
  "Run `dictAdder.py' with ARGS and return its stdout.\nSignal `user-error' when the script or dictionary is missing, or when the\nprocess cannot be started."
  (let ((python rime-wubi-dict-adder-python-command)
        (script (expand-file-name rime-wubi-dict-adder-script-path))
        (dict (rime-wubi-dict-adder--dict-file))
        (buffer (generate-new-buffer " *rime-wubi-dict-adder*")))
    (unwind-protect
        (progn
          (unless (file-exists-p dict)
            (user-error "Rime dictionary not found: %s" dict))
          (unless (file-exists-p script)
            (user-error "dictAdder.py not found: %s" script))
          (let* ((full-args (append (list script) args (list "-d" dict)))
                 (status (apply #'call-process python nil buffer nil full-args))
                 (output (with-current-buffer buffer
                           (buffer-substring-no-properties (point-min) (point-max)))))
            (cons status output)))
      (kill-buffer buffer))))

(defun rime-wubi-dict-adder--parse-json (output)
  "Return the JSON value on the last JSON-looking line of OUTPUT, or nil.\n`dictAdder.py' prints an array when adding words and an object when checking."
  (let ((line (car (last (seq-filter
                          (lambda (l)
                            (let ((trimmed (string-trim l)))
                              (or (string-prefix-p "[" trimmed)
                                  (string-prefix-p "{" trimmed))))
                          (split-string output "\n"))))))
    (when line
      (condition-case nil
          (json-parse-string (string-trim line)
                             :object-type 'alist :array-type 'list
                             :null-object nil :false-object nil)
        (error nil)))))

(defun rime-wubi-dict-adder--run (words)
  "Ask `dictAdder.py' to add WORDS; return the parsed result list.\nSignal `user-error' when the script fails or returns garbage."
  (let* ((result (rime-wubi-dict-adder--call words))
         (status (car result))
         (output (cdr result))
         (parsed (rime-wubi-dict-adder--parse-json output)))
    (or parsed
        (user-error "dictAdder.py failed (exit %s): %s"
                    status (string-trim output)))))

(defun rime-wubi-dict-adder--deploy ()
  "Redeploy Rime when `rime-wubi-dict-adder-deploy-command' is configured."
  (when rime-wubi-dict-adder-deploy-command
    (condition-case err
        (apply #'start-process "rime-wubi-deploy" " *rime-wubi-deploy*"
               rime-wubi-dict-adder-deploy-command)
      (error
       (display-warning 'rime-wubi-dict-adder
                        (format "Rime redeploy failed: %s" (error-message-string err))
                        :warning)))))

(defun rime-wubi-dict-adder--report (results already-present)
  "Report RESULTS and ALREADY-PRESENT words; signal on failures."
  (let ((added (seq-filter (lambda (r) (equal (alist-get 'status r) "added")) results))
        (existing (append already-present
                          (mapcar (lambda (r) (alist-get 'word r))
                                  (seq-filter (lambda (r) (equal (alist-get 'status r) "exists"))
                                              results))))
        (failed (seq-filter (lambda (r) (equal (alist-get 'status r) "error")) results)))
    (when existing
      (message "Rime: %s 已存在" (mapconcat #'identity (delete-dups existing) "、")))
    (cond
     (failed
      (user-error
       "Rime: 未写入任何词 —— %s"
       (mapconcat (lambda (r)
                    (format "%s（%s）" (alist-get 'word r) (or (alist-get 'reason r) "unknown")))
                  failed "；")))
     (added
      (message "Rime: 已添加 %s"
               (mapconcat (lambda (r) (format "%s→%s" (alist-get 'word r) (alist-get 'code r)))
                          added "、"))
      (rime-wubi-dict-adder--deploy)))))

;;;; Public commands

(defun rime-wubi-dict-adder-with-python (word &rest more)
  "Add WORD (and MORE) and their Wubi codes to the dictionary.\nAlready-present words are answered from the dictionary index without starting\nPython."
  (interactive (list (read-string "Word: ")))
  (rime-wubi-dict-adder-add (cons word more)))

(defun rime-wubi-dict-adder-add (words)
  "Add each of WORDS to the dictionary, writing nothing if any of them fails."
  (setq words (delete-dups (delq nil (mapcar #'string-trim words))))
  (setq words (seq-remove #'string-empty-p words))
  (unless words
    (user-error "Rime: no word to add"))
  (let* ((index (rime-wubi-dict-adder--index))
         (existing (seq-filter (lambda (w) (gethash w index)) words))
         (new (seq-remove (lambda (w) (gethash w index)) words)))
    (if (null new)
        (message "Rime: %s 已存在，未启动 python"
                 (mapconcat #'identity existing "、"))
      (let ((results (rime-wubi-dict-adder--run new)))
        (rime-wubi-dict-adder--invalidate-index)
        (rime-wubi-dict-adder--report results existing)))))

(defun rime-wubi-dict-adder (word code)
  "Add WORD with the given CODE to the dictionary without starting Python."
  (interactive "sWord: \nsCode: ")
  (setq word (string-trim word))
  (setq code (string-trim code))
  (unless (and (not (string-empty-p word)) (not (string-empty-p code)))
    (user-error "Rime: word and code must both be non-empty"))
  (unless (string-match-p rime-wubi-dict-adder--code-regexp code)
    (user-error "Rime: %S is not a valid Wubi code (expected 1-4 lowercase letters)" code))
  (when (rime-wubi-dict-adder--known-p word)
    (user-error "Rime: %s 已存在" word))
  (let ((file (rime-wubi-dict-adder--dict-file)))
    (unless (file-exists-p file)
      (user-error "Rime dictionary not found: %s" file))
    (let ((needs-newline
           (with-temp-buffer
             (insert-file-contents file nil (max (point-min) (1- (file-attribute-size
                                                                 (file-attributes file))))
                                   nil)
             (not (eq (char-before) ?\n)))))
      (with-temp-buffer
        (when needs-newline (insert "\n"))
        (insert (format "%s\t%s\n" word code))
        (append-to-file (point-min) (point-max) file))))
  (rime-wubi-dict-adder--invalidate-index)
  (message "Rime: 已添加 %s→%s（未启动 python）" word code)
  (rime-wubi-dict-adder--deploy))

(defun rime-wubi-dict-adder-from-selected-region (beg end)
  "Add the words in the selected region (BEG to END) to the dictionary.\nThe region may hold several words separated by whitespace; they are added in\none Python call."
  (interactive
   (if (use-region-p)
       (list (region-beginning) (region-end))
     (user-error "Rime: no active region")))
  (rime-wubi-dict-adder-add
   (split-string (buffer-substring-no-properties beg end) "[ \t\n\r]+" t)))

(defun rime-wubi-dict-adder-2-character-back ()
  "Add the two characters before point to the dictionary."
  (interactive)
  (if (< (point) 2)
      (user-error "Rime: not enough characters before point")
    (rime-wubi-dict-adder-add
     (list (buffer-substring-no-properties (- (point) 2) (point))))))

;;;; Full audit

(defconst rime-wubi-dict-adder--check-severity
  '(("format" . error)
    ("invalid-code" . error)
    ("invalid-weight" . error)
    ("duplicate" . error)
    ("mismatch" . error)
    ("shorter" . warn)
    ("unverifiable" . warn))
  "Severity of each finding status reported by `dictAdder.py --check'.")

(defun rime-wubi-dict-adder--check-fetch ()
  "Run the full dictionary audit and return the parsed JSON."
  (let* ((result (rime-wubi-dict-adder--call (list "--check")))
         (status (car result))
         (output (cdr result)))
    (or (rime-wubi-dict-adder--parse-json output)
        (user-error "dictAdder.py --check failed (exit %s): %s"
                    status (string-trim output)))))

(defun rime-wubi-dict-adder-visit-entry (line)
  "Open the dictionary at LINE."
  (interactive "nLine: ")
  (find-file-other-window (rime-wubi-dict-adder--dict-file))
  (goto-char (point-min))
  (forward-line (max 0 (1- line))))

(defun rime-wubi-dict-adder-check-dict ()
  "Audit the dictionary with pywubi and report problems.
Like `rime-wubi-dict-adder-lint-dict' but also recomputes each entry's code
and detects duplicate words.  RET jumps to the offending line."
  (interactive)
  (let* ((data (rime-wubi-dict-adder--check-fetch))
         (summary (alist-get 'summary data))
         (findings (alist-get 'findings data))
         (errors (alist-get 'errors summary))
         (warnings (alist-get 'warnings summary))
         (entries (alist-get 'entries summary))
         (buffer (get-buffer-create "*rime-wubi-dict-adder-check*")))
    (with-current-buffer buffer
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "词典：%s\n" (rime-wubi-dict-adder--dict-file)))
        (insert (format "条目 %d 条 · ERROR %d · warn %d%s\n\n"
                        (or entries 0) (or errors 0) (or warnings 0)
                        (if (and (zerop (or errors 0)) (zerop (or warnings 0)))
                            "（未发现问题）" "")))
        (dolist (item findings)
          (let* ((line (alist-get 'line item))
                 (status (alist-get 'status item))
                 (severity (or (alist-get status rime-wubi-dict-adder--check-severity
                                          nil nil #'equal)
                               'warn))
                 (start (point)))
            (insert (format "%5s  %-5s %-13s %-18s %-14s %s\n"
                            (or line 0)
                            (if (eq severity 'error) "ERROR" "warn")
                            status
                            (truncate-string-to-width (or (alist-get 'word item) "") 16 nil nil "…")
                            (truncate-string-to-width (or (alist-get 'code item) "") 12 nil nil "…")
                            (concat (or (alist-get 'reason item) "")
                                    (if-let* ((sugg (alist-get 'suggested item)))
                                        (format "  → 建议 %s" sugg)
                                      ""))))
            (put-text-property start (point) 'rime-wubi-dict-adder-line line)
            (put-text-property start (point) 'rime-wubi-dict-adder-entry t)))
      (goto-char (point-min))
      (rime-wubi-dict-adder-check-mode)))
    (display-buffer buffer)
    (message "Rime 体检：%d 条条目，ERROR %d，warn %d"
             (or entries 0) (or errors 0) (or warnings 0))))

(defvar rime-wubi-dict-adder-check-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map special-mode-map)
    (define-key map (kbd "g") #'rime-wubi-dict-adder-check-dict)
    (define-key map (kbd "RET") #'rime-wubi-dict-adder-check-visit)
    map)
  "Keymap for `rime-wubi-dict-adder-check-mode'.")

(define-derived-mode rime-wubi-dict-adder-check-mode special-mode
  "Rime-Check"
  "Major mode for the Rime dictionary audit report."
  (setq buffer-read-only t))

(defun rime-wubi-dict-adder-check-visit ()
  "Jump to the dictionary line reported on the current line."
  (interactive)
  (let ((line (get-text-property (line-beginning-position) 'rime-wubi-dict-adder-line)))
    (unless line
      (user-error "No dictionary line on this line"))
    (rime-wubi-dict-adder-visit-entry line)))

;;;; Lint

(defconst rime-wubi-dict-adder--symbol-code-regexp "\\`z[a-z]\\{0,3\\}\\'"
  "Regexp matching Rime's symbol namespace (`z` + 0-3 letters).\nEntries whose code lives in this namespace are deliberately non-word symbols\n(like `·' or `->'), so their word part is not expected to be CJK.")

(defun rime-wubi-dict-adder--lint-line (line)
  "Classify dictionary LINE.\nReturn nil for blank/comment lines, or a cons (SEVERITY . MESSAGE) where\nSEVERITY is `error' (the entry is malformed) or `warn' (odd but plausible)."
  (let ((trimmed (string-trim-left line)))
    (cond
     ((string-empty-p (string-trim line)) nil)
     ((string-prefix-p "#" trimmed) nil)
     ((string-prefix-p "..." trimmed) nil)
     (t
      (let ((fields (split-string line "\t")))
        (if (< (length fields) 2)
            (cons 'error "没有 TAB 分隔")
          (let ((word (nth 0 fields))
                (code (nth 1 fields))
                (weight (nth 2 fields)))
            (cond
             ((not (string-match-p rime-wubi-dict-adder--code-regexp code))
              (cons 'error (format "码非法：%S" code)))
             ((and weight (not (string-match-p "\\`[0-9]+\\'" weight)))
              (cons 'error (format "权重列非法：%S" weight)))
             ((string-match-p "\\`z[a-z]\\{0,3\\}\\'" code) nil) ; symbol entry
             ((string-match-p "[[:space:]]" word)
              (cons 'warn "词中含空白"))
             ((not (string-match-p rime-wubi-dict-adder--word-regexp word))
              (cons 'warn "词里混入了非汉字字符"))
             (t nil)))))))))

(defun rime-wubi-dict-adder-lint-dict ()
  "List suspicious entries in the Rime dictionary (read-only)."
  (interactive)
  (let ((file (rime-wubi-dict-adder--dict-file))
        (issues nil)
        (line-number 0))
    (unless (file-exists-p file)
      (user-error "Rime dictionary not found: %s" file))
    (with-temp-buffer
      (insert-file-contents file)
      (goto-char (point-min))
      (let ((in-header t))
        (while (not (eobp))
          (setq line-number (1+ line-number))
          (let* ((line (buffer-substring-no-properties
                        (line-beginning-position) (line-end-position)))
                 (trimmed (string-trim-left line)))
            (cond
             ((and in-header (string-prefix-p "..." trimmed))
              (setq in-header nil))
             (in-header nil)
             (t
              (pcase-let ((`(,severity . ,issue)
                           (rime-wubi-dict-adder--lint-line line)))
                (when severity
                  (push (format "%5d  %-5s %-24s %s" line-number
                                (if (eq severity 'error) "ERROR" "warn")
                                issue
                                (truncate-string-to-width line 88 nil nil "…"))
                        issues))))))
          (forward-line 1))))
    (setq issues (nreverse issues))
    (let ((buffer (get-buffer-create "*rime-wubi-dict-adder-lint*")))
      (with-current-buffer buffer
        (let ((inhibit-read-only t))
          (erase-buffer)
          (insert (format "%s\n可疑条目 %d 条（只报告，不修改）\n\n" file (length issues)))
          (insert (if issues (mapconcat #'identity issues "\n") "（无）"))
          (insert "\n"))
        (goto-char (point-min))
        (special-mode))
      (display-buffer buffer))
    (message "Rime: %d 条可疑条目" (length issues))))

(provide 'rime-wubi-dict-adder)
;;; rime-wubi-dict-adder.el ends here
